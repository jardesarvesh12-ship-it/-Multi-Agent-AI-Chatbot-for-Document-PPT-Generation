# ============================================================
# Multi-Agent AI Chatbot — Environment Variables
# Copy this file to .env and fill in your API keys
# ============================================================

# --- LLM: Groq API (Free) ---
# Sign up at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# --- Web Search: Tavily API (Free tier) ---
# Sign up at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# --- ChromaDB (Local - no key needed) ---
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=enterprise_knowledge

# --- Embeddings (Local sentence-transformers) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- File Storage ---
UPLOAD_DIR=./uploads
GENERATED_DIR=./generated
VERSIONS_DIR=./versions

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,docx,pptx,png,jpg,jpeg,tiff

# --- CORS (Frontend URL) ---
FRONTEND_URL=http://localhost:5173
